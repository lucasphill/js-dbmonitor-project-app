{
  "name": "dbmonitor-desktop",
  "productName": "DBMonitor",
  "description": "Dashboard desktop de observabilidade PostgreSQL",
  "version": "0.1.3",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"next dev --hostname 127.0.0.1 --port 3000\" \"wait-on http://127.0.0.1:3000 && electron . --dev\"",
    "build": "next build",
    "start": "electron .",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win nsis",
    "dist:linux": "npm run build && electron-builder --linux AppImage deb",
    "test": "node --test --test-isolation=none",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.47.0",
    "pg": "^8.23.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-is": "^19.2.0",
    "recharts": "^3.8.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "concurrently": "^9.2.1",
    "electron": "^44.3.0",
    "electron-builder": "^26.16.1",
    "next": "^16.3.5",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "wait-on": "^8.0.4"
  },
  "build": {
    "appId": "com.bdash.desktop",
    "productName": "DBMonitor",
    "files": [
      "electron/**/*",
      "out/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "include": "build/installer.nsh"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "executableName": "dbmonitor",
      "maintainer": "DBMonitor Contributors <noreply@github.com>"
    }
  }
}
